[
  {
    "id": "tab-shelly-admin-01",
    "type": "tab",
    "label": "Shelly admin - discovery and monitoring",
    "disabled": false,
    "info": "Use at your own risk \u2013 no warranty. Configure authorized networks only."
  },
  {
    "id": "cfg-shelly-admin-01",
    "type": "shelly-admin-config",
    "name": "Local Shelly fleet",
    "targets": "192.168.1.0/24",
    "autoSubnets": true,
    "minimumAutoPrefix": 24,
    "maxAddresses": 4096,
    "discoveryConcurrency": 32,
    "monitorConcurrency": 16,
    "timeoutMs": 2500,
    "fullScanIntervalHours": 168,
    "contextStore": "file",
    "rawRetentionHours": 48,
    "aggregateRetentionDays": 90,
    "bucketMinutes": 60,
    "anomalyMinSamples": 24,
    "anomalyWarmupSamples": 12,
    "anomalyTriggerConsecutive": 3,
    "anomalyClearConsecutive": 3,
    "anomalyCooldownMinutes": 120,
    "temperatureWarningC": 70,
    "temperatureCriticalC": 85,
    "temperatureHysteresisC": 5,
    "temperatureConsecutive": 3,
    "temperatureCooldownMinutes": 15,
    "policies": "[]",
    "firmwarePolicy": "stable",
    "maintenanceDeviceTimeoutSeconds": 15,
    "maintenanceRunTimeoutSeconds": 900,
    "firmwareCheckTimeoutMs": 2500,
    "maxRawSamplesPerDevice": 10000,
    "maxBucketsPerDevice": 10000,
    "maxBytesPerDevice": 1048576,
    "anomalyProfile": "Conservative",
    "baselineWindowDays": 30,
    "peerMinDevices": 3,
    "peerFirmwareMajor": true,
    "restartWindowHours": 24,
    "restartThreshold": 3,
    "enableRecovery": true,
    "enableLatencyTrend": true,
    "enableTemperatureTrend": true,
    "enableRestartPattern": true,
    "enableResources": true,
    "enableElectrical": true,
    "enablePeerComparison": true
  },
  {
    "id": "discover-01",
    "type": "shelly-admin-discovery",
    "z": "tab-shelly-admin-01",
    "name": "Incremental inventory",
    "admin": "cfg-shelly-admin-01",
    "mode": "incremental",
    "scanOnStart": true,
    "startDelaySeconds": 2,
    "x": 390,
    "y": 100,
    "wires": [
      [
        "debug-inventory-01"
      ],
      [
        "debug-events-01"
      ],
      [
        "debug-errors-01"
      ]
    ]
  },
  {
    "id": "inject-full-01",
    "type": "inject",
    "z": "tab-shelly-admin-01",
    "name": "Authorized full scan",
    "props": [
      {
        "p": "mode",
        "v": "full",
        "vt": "str"
      }
    ],
    "once": false,
    "x": 150,
    "y": 100,
    "wires": [
      [
        "discover-01"
      ]
    ]
  },
  {
    "id": "monitor-01",
    "type": "shelly-admin-monitor",
    "z": "tab-shelly-admin-01",
    "name": "Health and early warnings",
    "admin": "cfg-shelly-admin-01",
    "periodic": true,
    "intervalSeconds": 60,
    "automationMode": "notify",
    "x": 180,
    "y": 220,
    "wires": [
      [
        "debug-health-01"
      ],
      [
        "debug-alerts-01"
      ],
      [
        "debug-errors-01"
      ]
    ],
    "firmwarePolicy": "",
    "outputMode": "current-and-transitions"
