[
  {
    "id": "tab-shelly-admin-02",
    "type": "tab",
    "label": "Shelly admin - safe maintenance",
    "disabled": false,
    "info": "Dry-run first. Select exact pilot devices. Supervise real updates and reboots."
  },
  {
    "id": "cfg-shelly-admin-02",
    "type": "shelly-admin-config",
    "name": "Shelly lab fleet",
    "targets": "192.168.1.20-30",
    "autoSubnets": false,
    "minimumAutoPrefix": 24,
    "maxAddresses": 64,
    "discoveryConcurrency": 8,
    "monitorConcurrency": 8,
    "timeoutMs": 2500,
    "fullScanIntervalHours": 168,
    "contextStore": "file",
    "rawRetentionHours": 48,
    "aggregateRetentionDays": 90,
    "bucketMinutes": 60,
    "anomalyMinSamples": 12,
    "anomalyWarmupSamples": 6,
    "anomalyTriggerConsecutive": 3,
    "anomalyClearConsecutive": 2,
    "anomalyCooldownMinutes": 60,
    "temperatureWarningC": 70,
    "temperatureCriticalC": 85,
    "temperatureHysteresisC": 5,
    "temperatureConsecutive": 3,
    "temperatureCooldownMinutes": 15,
    "policies": "[]"
  },
  {
    "id": "maintenance-02",
    "type": "shelly-admin-maintenance",
    "z": "tab-shelly-admin-02",
    "name": "Pilot dry-run",
    "admin": "cfg-shelly-admin-02",
    "action": "update",
    "deviceSelectors": "REPLACE-WITH-EXACT-DEVICE-ID",
    "allowAll": false,
    "dryRun": true,
    "stage": "stable",
    "staggerSeconds": 60,
    "waitBeforeValidationSeconds": 5,
    "validationTimeoutSeconds": 180,
    "conditionType": "firmwareAvailable",
    "conditionValue": "",
    "failFast": true,
    "scheduleHours": 0,
    "scheduleMode": "notify",
    "automaticUpdates": false,
    "x": 390,
    "y": 120,
    "wires": [["debug-result-02"], ["debug-progress-02"], ["debug-errors-02"]]
  },
  {
    "id": "inject-check-02",
    "type": "inject",
    "z": "tab-shelly-admin-02",
    "name": "Check firmware",
    "props": [{ "p": "action", "v": "check", "vt": "str" }],
    "x": 140,
    "y": 80,
    "wires": [["maintenance-02"]]
  },
  {
    "id": "inject-dry-02",
    "type": "inject",
    "z": "tab-shelly-admin-02",
    "name": "Dry-run update",
    "props": [{ "p": "action", "v": "update", "vt": "str" }, { "p": "dryRun", "v": "true", "vt": "bool" }],
    "x": 140,
    "y": 140,
    "wires": [["maintenance-02"]]
  },
  {
    "id": "debug-result-02",
    "type": "debug",
    "z": "tab-shelly-admin-02",
    "name": "Maintenance result",
    "active": true,
    "complete": "payload",
    "x": 680,
    "y": 80,
    "wires": []
  },
  {
    "id": "debug-progress-02",
    "type": "debug",
    "z": "tab-shelly-admin-02",
    "name": "Device results",
    "active": true,
    "complete": "payload",
    "x": 680,
    "y": 120,
    "wires": []
  },
  {
    "id": "debug-errors-02",
    "type": "debug",
    "z": "tab-shelly-admin-02",
    "name": "Maintenance errors",
    "active": true,
    "complete": "payload",
    "x": 690,
    "y": 160,
    "wires": []
  },
  {
    "id": "warning-02",
    "type": "comment",
    "z": "tab-shelly-admin-02",
    "name": "Keep dry-run enabled until exact pilot IDs and conditions are verified",
    "info": "Real input-triggered update/reboot also requires msg.confirm=true. Use at your own risk – no warranty.",
    "x": 360,
    "y": 40,
    "wires": []
  }
]
