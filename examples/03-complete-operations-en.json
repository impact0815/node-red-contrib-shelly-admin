  {
    "id": "fn-health-en",
    "type": "function",
    "z": "tab-shelly-admin-03-en",
    "name": "Health/history + compact findings",
    "func": "flow.set(\"shellyAdminHealth\", msg.payload);\nflow.set(\"shellyAdminFindings\", {summaryText: msg.payload.summaryText, summaryTextDe: msg.payload.summaryTextDe, humanSummary: msg.payload.humanSummary, findingsSummary: msg.payload.findingsSummary, cards: msg.payload.cards});\nconst compact = RED.util.cloneMessage(msg);\ncompact.topic = \"shelly-admin/findings-summary\";\ncompact.payload = {summaryText: msg.payload.summaryText, summaryTextDe: msg.payload.summaryTextDe, humanSummary: msg.payload.humanSummary, findingsSummary: msg.payload.findingsSummary, cards: msg.payload.cards};\nreturn [msg, compact];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 800,
    "y": 260,
    "wires": [
      [],
      [
        "debug-findings-en"
      ]
    ]
  },
  {
    "id": "fn-route-alerts-en",
    "type": "function",
    "z": "tab-shelly-admin-03-en",
    "name": "Alert, recovery, temperature, firmware, anomaly/trend router",
    "func": "const buckets = [[], [], [], []];\nconst observations = Array.isArray(msg.payload && msg.payload.observations) ? msg.payload.observations : [];\nfor (const observation of observations) {\n    const copy = RED.util.cloneMessage(msg);\n    copy.payload = observation;\n    copy.topic = \"shelly-admin/observation/\" + observation.kind;\n    if (observation.category === \"recovery\" || observation.lifecycle === \"cleared\") buckets[1].push(copy);\n    if (observation.kind === \"temperature\") buckets[2].push(copy);\n    if ([\"latency-trend\", \"temperature-trend\", \"restart-pattern\", \"resource-trend\", \"electrical-observation\", \"latency-network-factor\"].includes(observation.kind)) buckets[3].push(copy);\n    if ([\"warning\", \"critical\"].includes(observation.severity) && [\"opened\", \"updated\"].includes(observation.lifecycle)) buckets[0].push(copy);\n}\nflow.set(\"shellyAdminAlerts\", msg.payload);\nflow.set(\"shellyAdminFindings\", {summaryText: msg.payload.summaryText, summaryTextDe: msg.payload.summaryTextDe, humanSummary: msg.payload.humanSummary, findingsSummary: msg.payload.findingsSummary, cards: msg.payload.cards});\nreturn buckets.map((items) => items.length ? items : null);",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 840,
    "y": 340,
    "wires": [
      [
        "fn-notify-en"
      ],
      [
        "debug-recovery-en"
      ],
      [
        "debug-temperature-en"
      ],
      [
        "debug-trends-en"
      ]
    ]
  },
