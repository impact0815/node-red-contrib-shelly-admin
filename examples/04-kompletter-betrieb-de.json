    "z": "tab-shelly-admin-03-de",
    "name": "Dashboard HTML",
    "func": "function esc(value) { return String(value).replace(/[&<>\"']/g, (c) => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"\\\"\":\"&quot;\",\"'\":\"&#39;\"}[c])); }\nconst data = {\n  inventory: flow.get(\"shellyAdminInventory\") || null,\n  health: flow.get(\"shellyAdminHealth\") || null,\n  findings: flow.get(\"shellyAdminFindings\") || null,\n  alerts: flow.get(\"shellyAdminAlerts\") || null,\n  maintenance: flow.get(\"shellyAdminMaintenance\") || null\n};\nmsg.headers = {\"content-type\":\"text/html; charset=utf-8\",\"cache-control\":\"no-store\"};\nmsg.payload = `<!doctype html><html><head><meta charset=\"utf-8\"><meta http-equiv=\"refresh\" content=\"15\"><title>Shelly Admin</title><style>body{font:14px system-ui;margin:2rem;background:#111;color:#eee}section{background:#222;padding:1rem;margin:1rem 0;border-radius:.5rem}pre{white-space:pre-wrap;overflow-wrap:anywhere}.ok{color:#7ee787}</style></head><body><h1>Shelly Admin 0.3.0</h1><p class=\"ok\">Refresh: 15 s</p>${Object.entries(data).map(([k,v])=>`<section><h2>${esc(k)}</h2><pre>${esc(JSON.stringify(v,null,2))}</pre></section>`).join(\"\")}</body></html>`;\nreturn msg;",
