  {
    "id": "monitor-notify-050",
    "type": "shelly-admin-monitor",
    "z": "tab-notify-050",
    "name": "Monitor",
    "admin": "cfg-notify-050",
    "periodic": true,
    "intervalSeconds": 60,
    "automationMode": "notify",
    "firmwarePolicy": "",
    "outputMode": "current-and-transitions",
    "x": 170,
    "y": 120,
    "wires": [
      [],
      [
        "filter-notify-050"
      ],
      []
    ]
  },
  {
    "id": "filter-notify-050",
    "type": "function",
    "z": "tab-notify-050",
    "name": "Only notify === true, with uptime text",
    "func": "const observations = Array.isArray(msg.payload && msg.payload.observations)\n    ? msg.payload.observations.filter((item) => item.notify === true)\n    : [];\nif (!observations.length) return null;\nmsg.payload = observations.map((item) => {\n    const summary = item.summaryText || (Array.isArray(item.reasons) && item.reasons[0]) || item.kind || \"Shelly notice\";\n    const uptime = item.uptimeText || \"Uptime: not available\";\n    return {...item, notificationText: /(?:^|\\s)Uptime\\s*:/i.test(summary) ? summary : summary + \" \" + uptime};\n});\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 120,
    "wires": [
      [
        "debug-notify-050"
      ]
    ]
  },
  {
    "id": "debug-notify-050",
    "type": "debug",
    "z": "tab-notify-050",
    "name": "Connect to Signal sender",
    "active": true,
