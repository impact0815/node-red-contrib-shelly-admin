  {
    "id": "af32pvstring000002",
    "type": "function",
    "z": "0ad6398788139365",
    "name": "Save PV string configuration",
    "func": "/**\n * Save PV string configuration\n *\n * Erwartet msg.payload = {\n *   action: \"savePvStringConfig\",\n *   strings: [{ name, panels, panelWp }, { name, panels, panelWp }],\n *   minTotalPower, warningPct, criticalPct, sampleCount\n * }\n *\n * Stores server-side in context store \"file\" (fallback: default store).\n */\n\nconst STORE = \"file\";\nconst p = msg.payload || {};\n\nfunction save(key, value) {\n    try { flow.set(key, value, STORE); }\n    catch (e) { flow.set(key, value); }\n}\n\nfunction finite(v) { return v !== null && v !== \"\" && Number.isFinite(Number(v)); }\nfunction between(v, a, b) { return finite(v) && Number(v) >= a && Number(v) <= b; }\nfunction name(v, fallback) {\n    const s = String(v || \"\").trim().slice(0, 24);\n    return s || fallback;\n}\n\nif (p.action !== \"savePvStringConfig\") {\n    node.status({ fill: \"yellow\", shape: \"ring\", text: \"Unknown configuration command\" });\n    return null;\n}\n\nif (!Array.isArray(p.strings) || p.strings.length !== 2) {\n    node.status({ fill: \"red\", shape: \"dot\", text: \"Exactly two strings required\" });\n    return null;\n}\n\nconst strings = p.strings.map((s, i) => ({\n    name: name(s && s.name, `PV${i + 1}`),\n    panels: Number(s && s.panels),\n    panelWp: Number(s && s.panelWp)\n}));\n\nif (strings.some(s => !between(s.panels, 1, 30) || !Number.isInteger(s.panels) || !between(s.panelWp, 100, 1000))) {\n    node.status({ fill: \"red\", shape: \"dot\", text: \"Invalid panel configuration\" });\n    return null;\n}\n\nconst config = {\n    strings,\n    minTotalPower: Number(p.minTotalPower),\n    warningPct: Number(p.warningPct),\n    criticalPct: Number(p.criticalPct),\n    sampleCount: Number(p.sampleCount)\n};\n\nif (!between(config.minTotalPower, 100, 10000) ||\n    !between(config.warningPct, 5, 50) ||\n    !between(config.criticalPct, 10, 75) ||\n    config.criticalPct <= config.warningPct ||\n    !between(config.sampleCount, 3, 30) || !Number.isInteger(config.sampleCount)) {\n    node.status({ fill: \"red\", shape: \"dot\", text: \"Invalid thresholds\" });\n    return null;\n}\n\nsave(\"alphaPvStringConfig\", config);\nflow.set(\"alphaFeedback\", {\n    ts: Date.now(), ok: true,\n    de: \"PV-String-Konfiguration gespeichert\",\n    en: \"PV string configuration saved\"\n});\nnode.status({ fill: \"green\", shape: \"dot\", text: `${strings[0].panels}×${strings[0].panelWp} Wp / ${strings[1].panels}×${strings[1].panelWp} Wp` });\n\nreturn { trigger: true };",
