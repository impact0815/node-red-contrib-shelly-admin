    "name": "PV string diagnostics & configuration",
    "order": 2,
    "width": "12",
    "height": "0",
    "head": "",
    "format": "<template>\n<section class=\"pva\">\n  <div class=\"pva-title\">\n    <div>\n      <small>PV STRING DIAGNOSTICS</small>\n      <h3>{{ t('title') }}</h3>\n    </div>\n    <div class=\"pva-actions\">\n      <span :class=\"['pva-state', assessment.cls]\"><i></i>{{ assessment.text }}</span>\n      <button class=\"pva-cog\" @click=\"editing = !editing\"><v-icon size=\"18\">mdi-cog-outline</v-icon>{{ t('config') }}</button>\n    </div>\n  </div>\n\n  <div v-if=\"!ready\" class=\"pva-empty\">{{ t('waiting') }}</div>\n\n  <template v-else>\n    <div class=\"pva-grid\">\n      <article v-for=\"(s, i) in stringRows\" :key=\"i\" class=\"pva-card\" :class=\"assessment.badIndex === i ? assessment.cls : ''\">\n        <header><span>{{ s.name }}</span><b>{{ watts(s.power) }}</b></header>\n        <div class=\"pva-bar\"><i :style=\"{ width: s.bar + '%' }\"></i><em :style=\"{ left: s.expectedBar + '%' }\"></em></div>\n        <div class=\"pva-kv\">\n          <div><span>{{ t('installed') }}</span><b>{{ kwp(s.installedWp) }}</b></div>\n          <div><span>{{ t('specific') }}</span><b>{{ specific(s.specific) }}</b></div>\n          <div><span>{{ t('voltage') }}</span><b>{{ number(s.voltage, 0) }} V</b></div>\n          <div><span>{{ t('current') }}</span><b>{{ number(s.current, 1) }} A</b></div>\n        </div>\n      </article>\n    </div>\n\n    <div class=\"pva-compare\">\n      <div class=\"pva-ratio\">\n        <span>{{ t('expectedRatio') }}</span><b>{{ number(expectedRatio, 2) }} : 1</b>\n      </div>\n      <div class=\"pva-ratio\">\n        <span>{{ t('actualRatio') }}</span><b>{{ actualRatio == null ? '–' : number(actualRatio, 2) + ' : 1' }}</b>\n      </div>\n      <div class=\"pva-ratio\">\n        <span>{{ t('deviation') }}</span><b :class=\"assessment.cls\">{{ deviation == null ? '–' : number(deviation, 1) + ' %' }}</b>\n      </div>\n      <div class=\"pva-ratio\">\n        <span>{{ t('samples') }}</span><b>{{ qualified.length }} / {{ cfg.sampleCount }}</b>\n      </div>\n    </div>\n\n    <p class=\"pva-note\"><v-icon size=\"16\">mdi-information-outline</v-icon>{{ t('note') }}</p>\n  </template>\n\n  <div v-if=\"editing\" class=\"pva-editor\">\n    <h4>{{ t('configuration') }}</h4>\n    <div class=\"pva-form\">\n      <template v-for=\"(s, i) in form.strings\" :key=\"i\">\n        <label>{{ t('name') }} {{ i + 1 }}<input v-model=\"s.name\" maxlength=\"24\"/></label>\n        <label>{{ t('panels') }}<input type=\"number\" min=\"1\" max=\"30\" step=\"1\" v-model.number=\"s.panels\"/></label>\n        <label>{{ t('panelWp') }}<input type=\"number\" min=\"100\" max=\"1000\" step=\"5\" v-model.number=\"s.panelWp\"/></label>\n      </template>\n      <label>{{ t('minPower') }}<input type=\"number\" min=\"100\" max=\"10000\" step=\"100\" v-model.number=\"form.minTotalPower\"/></label>\n      <label>{{ t('warning') }}<input type=\"number\" min=\"5\" max=\"50\" step=\"1\" v-model.number=\"form.warningPct\"/></label>\n      <label>{{ t('critical') }}<input type=\"number\" min=\"10\" max=\"75\" step=\"1\" v-model.number=\"form.criticalPct\"/></label>\n      <label>{{ t('sampleCount') }}<input type=\"number\" min=\"3\" max=\"30\" step=\"1\" v-model.number=\"form.sampleCount\"/></label>\n    </div>\n    <div class=\"pva-buttons\">\n      <button @click=\"resetForm\">{{ t('cancel') }}</button>\n      <button class=\"primary\" @click=\"saveConfig\">{{ t('save') }}</button>\n    </div>\n  </div>\n</section>\n</template>\n\n<script>\nexport default {\n  data () {\n    let lang = 'en'\n    try { lang = window.localStorage.getItem('alphaess-lang') || ((navigator.language || 'en').toLowerCase().startsWith('de') ? 'de' : 'en') } catch (e) {}\n    return {\n      aeState: {}, editing: false, samples: [], lastSampleAt: 0,\n      form: { strings: [{ name: 'PV1', panels: 10, panelWp: 405 }, { name: 'PV2', panels: 8, panelWp: 405 }], minTotalPower: 500, warningPct: 15, criticalPct: 25, sampleCount: 10 },\n      text: {\n        de: { title:'Stringvergleich & Plausibilitätsprüfung',config:'Konfiguration',waiting:'Warte auf Stringdaten …',installed:'Installiert',specific:'Spezifisch',voltage:'Spannung',current:'Strom',expectedRatio:'Erwartetes Verhältnis',actualRatio:'Gemessenes Verhältnis',deviation:'Abweichung',samples:'Messwerte',note:'Bewertung nur bei ausreichender PV-Leistung; kurze Wolken-, Schatten- und MPPT-Effekte werden über mehrere Messwerte geglättet.',configuration:'String-Konfiguration',name:'Name String',panels:'Module',panelWp:'Wp je Modul',minPower:'Mindestleistung gesamt (W)',warning:'Warnung ab (%)',critical:'Kritisch ab (%)',sampleCount:'Glättung (Messwerte)',cancel:'Abbrechen',save:'Speichern',ok:'Verhältnis plausibel',warn:'Abweichung auffällig',bad:'Abweichung kritisch',low:'Zu wenig PV-Leistung',collect:'Messwerte werden gesammelt',s1low:'String 1 relativ schwach',s2low:'String 2 relativ schwach' },\n        en: { title:'String comparison & plausibility check',config:'Configuration',waiting:'Waiting for string data …',installed:'Installed',specific:'Specific',voltage:'Voltage',current:'Current',expectedRatio:'Expected ratio',actualRatio:'Measured ratio',deviation:'Deviation',samples:'Samples',note:'Assessment only at sufficient PV power; short cloud, shade and MPPT effects are smoothed across several samples.',configuration:'String configuration',name:'String name',panels:'Panels',panelWp:'Wp per panel',minPower:'Minimum total power (W)',warning:'Warning from (%)',critical:'Critical from (%)',sampleCount:'Smoothing (samples)',cancel:'Cancel',save:'Save',ok:'Ratio plausible',warn:'Deviation noticeable',bad:'Deviation critical',low:'PV power too low',collect:'Collecting samples',s1low:'String 1 relatively weak',s2low:'String 2 relatively weak' }\n      }\n    }\n  },\n  mounted () { if (this.msg && this.msg.payload) this.apply(this.msg.payload) },\n  computed: {\n    L () { return this.text[this.lang] || this.text.en },\n    cfg () { return this.aeState.pvConfig || this.form },\n    inv () { return this.aeState.data?.details?.inverter || {} },\n    pv () { return Array.isArray(this.inv.pv) ? this.inv.pv : [] },\n    ready () { return this.pv.length >= 2 },\n    expectedRatio () { const a=this.installed(0), b=this.installed(1); return b > 0 ? a / b : 1 },\n    qualified () { return this.samples.slice(-Math.max(3, Number(this.cfg.sampleCount) || 10)) },\n    medianNorms () {\n      const med = arr => { const a=arr.slice().sort((x,y)=>x-y); if(!a.length) return null; const m=Math.floor(a.length/2); return a.length%2?a[m]:(a[m-1]+a[m])/2 }\n      return [med(this.qualified.map(x=>x.n1)), med(this.qualified.map(x=>x.n2))]\n    },\n    normalizedRatio () { const [a,b]=this.medianNorms; return a!=null && b>0 ? a/b : null },\n    actualRatio () { return this.normalizedRatio == null ? null : this.normalizedRatio * this.expectedRatio },\n    deviation () { if(this.normalizedRatio==null) return null; return Math.abs(this.normalizedRatio-1)*100 },\n    assessment () {\n      const total=this.power(0)+this.power(1)\n      if(total < Number(this.cfg.minTotalPower||500)) return {cls:'low',text:this.t('low'),badIndex:null}\n      if(this.qualified.length < Math.min(3,Number(this.cfg.sampleCount||10))) return {cls:'low',text:this.t('collect'),badIndex:null}\n      const d=this.deviation\n      const bad=this.normalizedRatio==null?null:(this.normalizedRatio<1?0:1)\n      const suffix=bad===0?this.t('s1low'):bad===1?this.t('s2low'):''\n      if(d>=Number(this.cfg.criticalPct||25)) return {cls:'bad',text:this.t('bad')+' · '+suffix,badIndex:bad}\n      if(d>=Number(this.cfg.warningPct||15)) return {cls:'warn',text:this.t('warn')+' · '+suffix,badIndex:bad}\n      return {cls:'ok',text:this.t('ok'),badIndex:null}\n    },\n    stringRows () {\n      const rows=[0,1].map(i=>{ const p=this.pv[i]||{}; const installedWp=this.installed(i); const power=this.power(i); return {name:this.cfg.strings?.[i]?.name||'PV'+(i+1),installedWp,power,voltage:p.voltage,current:p.current,specific:installedWp>0?power/installedWp:null} })\n      const max=Math.max(1,...rows.map(x=>x.specific||0)); return rows.map(x=>({...x,bar:(x.specific||0)/max*100,expectedBar:100}))\n    }\n  },\n  watch: {\n    msg: { deep:true, handler(m) { if(m&&m.payload)this.apply(m.payload) } }\n  },\n  methods: {\n    t(k){return this.L[k]||k},\n    apply(p){ this.aeState=p||{}; if(p.pvConfig&&!this.editing)this.form=JSON.parse(JSON.stringify(p.pvConfig)); this.addSample() },\n    installed(i){const s=this.cfg.strings?.[i];return Number(s?.panels||0)*Number(s?.panelWp||0)},\n    power(i){return Number(this.pv[i]?.power)||0},\n    addSample(){ const now=Date.now(); if(now-this.lastSampleAt<5000||!this.ready)return; const total=this.power(0)+this.power(1); if(total<Number(this.cfg.minTotalPower||500))return; const a=this.installed(0),b=this.installed(1); if(a<=0||b<=0)return; this.samples=[...this.samples,{t:now,n1:this.power(0)/a,n2:this.power(1)/b}].slice(-30); this.lastSampleAt=now },\n    resetForm(){this.form=JSON.parse(JSON.stringify(this.cfg));this.editing=false},\n    saveConfig(){this.send({payload:{action:'savePvStringConfig',...JSON.parse(JSON.stringify(this.form))}});this.editing=false;this.samples=[]},\n    number(v,d=0){const n=Number(v);return Number.isFinite(n)?n.toLocaleString(this.lang==='en'?'en-GB':'de-DE',{minimumFractionDigits:d,maximumFractionDigits:d}):'–'},\n    watts(v){const n=Number(v);return !Number.isFinite(n)?'–':n>=1000?this.number(n/1000,2)+' kW':this.number(n,0)+' W'},\n    kwp(v){return this.number(Number(v)/1000,2)+' kWp'},\n    specific(v){return v==null?'–':this.number(v*100,1)+' % Wp'}\n  }\n}\n</script>\n\n<style>\n.pva{margin-top:12px;padding:18px;border:1px solid #e2e8f0;border-radius:20px;background:#fff;box-shadow:0 8px 22px rgba(15,23,42,.05);color:#1e293b;font-family:Inter,system-ui,sans-serif}\n.pva-title,.pva-actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px}.pva-title small{color:#d97706;font-size:.64rem;font-weight:850;letter-spacing:.14em}.pva-title h3{margin:2px 0;font-size:1rem}.pva-actions{justify-content:flex-end}.pva-state{display:flex;align-items:center;gap:6px;padding:5px 10px;border-radius:99px;font-size:.7rem;font-weight:800}.pva-state i{width:8px;height:8px;border-radius:50%;background:currentColor}.pva-state.ok{color:#166534;background:#dcfce7}.pva-state.warn{color:#92400e;background:#fef3c7}.pva-state.bad{color:#991b1b;background:#fee2e2}.pva-state.low{color:#475569;background:#f1f5f9}.pva-cog{display:flex;align-items:center;gap:5px;padding:7px 10px;border:0;border-radius:10px;background:#f1f5f9;font:inherit;font-size:.72rem;cursor:pointer}.pva-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}.pva-card{padding:14px;border:1px solid #e2e8f0;border-radius:16px;background:#fbfdfe}.pva-card.warn{border-color:#fbbf24;background:#fffbeb}.pva-card.bad{border-color:#f87171;background:#fef2f2}.pva-card header{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px}.pva-card header span{font-weight:850}.pva-card header b{font-size:1.05rem}.pva-bar{position:relative;height:13px;border-radius:8px;background:#f1f5f9;overflow:hidden}.pva-bar i{display:block;height:100%;border-radius:8px;background:linear-gradient(90deg,#fcd34d,#f59e0b)}.pva-bar em{position:absolute;top:0;bottom:0;width:2px;background:#475569;transform:translateX(-2px)}.pva-kv{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px}.pva-kv div,.pva-ratio{padding:7px 9px;border-radius:10px;background:#f8fafc}.pva-kv span,.pva-ratio span{display:block;color:#64748b;font-size:.62rem}.pva-kv b,.pva-ratio b{font-size:.78rem}.pva-compare{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:12px}.pva-ratio b.warn{color:#d97706}.pva-ratio b.bad{color:#dc2626}.pva-note{display:flex;align-items:flex-start;gap:6px;margin:11px 0 0;color:#64748b;font-size:.68rem}.pva-empty{padding:25px;color:#94a3b8;text-align:center}.pva-editor{margin-top:14px;padding:14px;border-radius:14px;background:#f8fafc}.pva-editor h4{margin:0 0 10px}.pva-form{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.pva-form label{display:flex;flex-direction:column;gap:3px;color:#64748b;font-size:.65rem}.pva-form input{padding:7px 8px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;font:inherit}.pva-buttons{display:flex;justify-content:flex-end;gap:8px;margin-top:10px}.pva-buttons button{padding:8px 12px;border:0;border-radius:9px;background:#e2e8f0;font:inherit;font-weight:750;cursor:pointer}.pva-buttons .primary{color:#fff;background:#0f766e}@media(max-width:700px){.pva-grid,.pva-form{grid-template-columns:1fr}.pva-compare{grid-template-columns:1fr 1fr}}\n</style>",
