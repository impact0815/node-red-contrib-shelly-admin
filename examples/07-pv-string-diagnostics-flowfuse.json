  {
    "id": "cb490d21c998eccd",
    "type": "function",
    "z": "0ad6398788139365",
    "name": "Build dashboard model + PV config",
    "func": "/**\n * Build dashboard model (debounced)\n *\n * Combines data, alarms, history, unlock state, feedback and the\n * stored PV string configuration into ONE message.\n */\n\nconst DEBOUNCE_MS = 300;\nconst STORE = \"file\";\n\nfunction load(key, fallback) {\n    try {\n        const v = flow.get(key, STORE);\n        return v === undefined ? fallback : v;\n    } catch (e) {\n        const v = flow.get(key);\n        return v === undefined ? fallback : v;\n    }\n}\n\nfunction build() {\n    const model = load(\"alphaDash\", null) || {};\n    const history = load(\"alphaDashHistory\", []);\n    const pvConfig = load(\"alphaPvStringConfig\", {\n        strings: [\n            { name: \"PV1\", panels: 10, panelWp: 405 },\n            { name: \"PV2\", panels: 8, panelWp: 405 }\n        ],\n        minTotalPower: 500,\n        warningPct: 15,\n        criticalPct: 25,\n        sampleCount: 10\n    });\n    const armedUntil = flow.get(\"alphaArmedUntil\") || 0;\n    const now = Date.now();\n    const age = model.lastDataAt ? Math.round((now - Date.parse(model.lastDataAt)) / 1000) : null;\n\n    node.status({\n        fill: age === null ? \"grey\" : age < 120 ? \"green\" : \"yellow\",\n        shape: \"dot\",\n        text: age === null ? \"Waiting for data\" : `Data ${age} s ago · ${history.length} points`\n    });\n\n    return {\n        payload: {\n            data: model.data || null,\n            lastDataAt: model.lastDataAt || null,\n            alarm: model.alarm || null,\n            alarmLog: (model.alarmLog || []).slice(0, 30),\n            history: history.map(h => ({ t: h.t, pv: h.pv, load: h.load, grid: h.grid, batt: h.batt, soc: h.soc })),\n            pvConfig,\n            armed: armedUntil > now,\n            armedUntil,\n            feedback: flow.get(\"alphaFeedback\") || null\n        }\n    };\n}\n\nconst timer = context.get(\"timer\");\nif (timer) clearTimeout(timer);\n\ncontext.set(\"timer\", setTimeout(() => {\n    context.set(\"timer\", null);\n    node.send(build());\n}, DEBOUNCE_MS));\n\nreturn null;",
